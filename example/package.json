{
  "name": "react-ts",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "packageManager": "pnpm@12.11.1",
  "scripts": {
    "preinstall": "test -n \"$VERCEL\" || npx only-allow pnpm",
    "audit": "pnpm audit --audit-level=high",
    "dev": "nodemon ./dev_server.js",
    "dev:env": "node ./dev_server.js",
    "dev:local": "node ./dev_server.js --env=local",
    "dev:sandbox": "node ./dev_server.js --env=sandbox",
    "dev:partners": "node ./dev_server.js --env=partners",
    "dev:review": "node ./dev_server.js --env=review",
    "build": "tsc -b && vite build",
    "lint": "oxlint --type-aware --report-unused-disable-directives-severity=error .",
    "preview": "vite preview",
    "postinstall": "react-flagpack",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc -b --noEmit"
  },
  "dependencies": {
    "@remoteoss/remote-flows": "link:..",
    "axios": "1.20.0",
    "dompurify": "3.4.17",
    "dotenv": "18.0.6",
    "express": "5.3.0",
    "html-react-parser": "6.1.8",
    "jsonwebtoken": "9.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-flagpack": "2.0.6",
    "react-syntax-highlighter": "16.1.2",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@remoteoss/remote-json-schema-form-kit": "1.2.1",
    "@types/node": "24.12.4",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "6.1.2",
    "nodemon": "3.1.14",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "vite": "8.3.4"
  }
}
