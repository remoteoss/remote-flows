{
  "permissions": {
    "allow": [
      "Bash(npm run type-check)",
      "Bash(npm run lint)",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__get_console_message"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-bash-allowlist.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
