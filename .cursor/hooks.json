{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/auto-format.sh",
        "matcher": ".*\\.(ts|tsx|js|jsx|json|md|mdc)$",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/validate-all.sh",
        "timeout": 120
      }
    ]
  }
}
